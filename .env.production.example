# Copy to .env.production (gitignored). Never put real secrets in this example.
COMPOSE_PROJECT_NAME=secondhand-marketplace
PUBLIC_HOST=marketplace.example.com
PUBLIC_SCHEME=https
PUBLIC_PORT=443
# Nginx binds locally for an external HTTPS terminator on the same host.
PUBLISH_ADDRESS=127.0.0.1
HTTP_PORT=8080
SESSION_SECURE_COOKIE=true
APP_SUBNET=172.30.14.0/24
NGINX_INTERNAL_IP=172.30.14.10

# Required, private, stable across rebuilds/restarts. Generate APP_KEY once.
APP_KEY=
DB_DATABASE=marketplace_docker
DB_USERNAME=marketplace
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Optional: separate production merchant credentials. Empty means COD only.
ZALOPAY_APP_ID=
ZALOPAY_KEY1=
ZALOPAY_KEY2=
ZALOPAY_CREATE_URL=https://openapi.zalopay.vn/v2/create
ZALOPAY_QUERY_URL=https://openapi.zalopay.vn/v2/query
ZALOPAY_CALLBACK_URL=https://marketplace.example.com/api/v1/payments/zalopay/callback
ZALOPAY_EXPIRE_SECONDS=900
# Optional override; otherwise derived from PUBLIC_SCHEME/PUBLIC_HOST.
ZALOPAY_RETURN_URL=
