APP_NAME="Secondhand Marketplace"
# Mật khẩu tài khoản demo: tối thiểu 12 ký tự, đặt trong .env (không điền ở file mẫu này).
DEMO_PASSWORD=
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=secondhand_marketplace
DB_USERNAME=secondhand_app
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Keep log until private SMTP credentials are configured; switch to smtp to send email.
# Gmail: use an App Password (requires eligible 2-Step Verification), not your account password.
# MAIL_MAILER=smtp
MAIL_MAILER=log
# smtp on port 587 negotiates STARTTLS; do not use tls as the scheme.
MAIL_SCHEME=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# SMTP: set this to the authenticated sender or an authorized sender address.
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

FRONTEND_URLS=http://localhost:5173
SANCTUM_STATEFUL_DOMAINS=localhost:5173

SESSION_SECURE_COOKIE=false

SESSION_SAME_SITE=lax

ZALOPAY_APP_ID=
ZALOPAY_KEY1=
ZALOPAY_KEY2=
ZALOPAY_CREATE_URL=https://sb-openapi.zalopay.vn/v2/create
ZALOPAY_QUERY_URL=https://sb-openapi.zalopay.vn/v2/query
ZALOPAY_RETURN_URL=http://localhost:5173/payment/result
ZALOPAY_CALLBACK_URL=
ZALOPAY_EXPIRE_SECONDS=900

# Leave empty for direct local serving; never trust arbitrary forwarded headers.
TRUSTED_PROXIES=

# Trusted SPA reset page; never derive reset links from request headers.
PASSWORD_RESET_URL=http://localhost:5173/reset-password
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080
REVERB_ALLOWED_ORIGINS=localhost

# Winner claim duration after server finalization
AUCTION_WINNER_CHECKOUT_HOURS=24

# Send one reminder within this many minutes of the winner deadline; 0 disables reminders
AUCTION_CHECKOUT_REMINDER_MINUTES=60

# Product video uploads (KiB); PHP request limits must also allow this size.
PRODUCT_VIDEO_MAX_KB=51200

# Seller inventory presentation (not stock business rules)
SELLER_LOW_STOCK_THRESHOLD=5
SELLER_AUCTION_ENDING_SOON_MINUTES=60

# Admin Action Center (D5) thresholds; defaults shown.
ADMIN_FLAGGED_MIN_REPORTS=3
ADMIN_FLAGGED_WINDOW_DAYS=30
ADMIN_AUCTION_OVERDUE_MINUTES=2
