server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    server_tokens off;
    client_max_body_size 45m;

    # Exact public authority (including a non-default port) rejects host injection.
    if ($http_host != "${PUBLIC_HOST}") { return 444; }

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    location = /api { return 404; }

    location ^~ /api/ {
        include /etc/nginx/fastcgi_params;
        fastcgi_pass backend:9000;
        fastcgi_param SCRIPT_FILENAME /var/www/html/public/index.php;
        fastcgi_param SCRIPT_NAME /index.php;
        fastcgi_param HTTP_PROXY "";
        fastcgi_param HTTP_X_FORWARDED_FOR $remote_addr;
        fastcgi_param HTTP_X_FORWARDED_HOST "${PUBLIC_HOST}";
        fastcgi_param HTTP_X_FORWARDED_PROTO "${PUBLIC_SCHEME}";
        fastcgi_param HTTP_X_FORWARDED_PORT "${PUBLIC_PORT}";
        fastcgi_hide_header X-Powered-By;
        fastcgi_read_timeout 90s;
    }

    location = /sanctum/csrf-cookie {
        include /etc/nginx/fastcgi_params;
        fastcgi_pass backend:9000;
        fastcgi_param SCRIPT_FILENAME /var/www/html/public/index.php;
        fastcgi_param SCRIPT_NAME /index.php;
        fastcgi_param HTTP_PROXY "";
        fastcgi_param HTTP_X_FORWARDED_FOR $remote_addr;
        fastcgi_param HTTP_X_FORWARDED_HOST "${PUBLIC_HOST}";
        fastcgi_param HTTP_X_FORWARDED_PROTO "${PUBLIC_SCHEME}";
        fastcgi_param HTTP_X_FORWARDED_PORT "${PUBLIC_PORT}";
        fastcgi_hide_header X-Powered-By;
    }

    location = /up {
        include /etc/nginx/fastcgi_params;
        fastcgi_pass backend:9000;
        fastcgi_param SCRIPT_FILENAME /var/www/html/public/index.php;
        fastcgi_param SCRIPT_NAME /index.php;
        fastcgi_param HTTP_PROXY "";
        fastcgi_param HTTP_X_FORWARDED_FOR $remote_addr;
        fastcgi_param HTTP_X_FORWARDED_HOST "${PUBLIC_HOST}";
        fastcgi_param HTTP_X_FORWARDED_PROTO "${PUBLIC_SCHEME}";
        fastcgi_param HTTP_X_FORWARDED_PORT "${PUBLIC_PORT}";
        fastcgi_hide_header X-Powered-By;
    }

    location /storage/ {
        alias /var/www/html/storage/app/public/;
        autoindex off;
    }

    location /assets/ {
        try_files $uri =404;
        expires 1y;
    }

    location ~ (^|/)\. { return 404; }
    location ~ \.php(?:/|$) { return 404; }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
