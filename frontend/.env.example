# Browser requests stay on localhost so Sanctum cookies and CSRF remain same-origin.
VITE_API_BASE_URL=/
VITE_BACKEND_PROXY_TARGET=http://127.0.0.1:8000

# Reverb public client key only; never place the server secret in Vite variables.
VITE_REVERB_APP_KEY=
VITE_REVERB_HOST=127.0.0.1
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http
